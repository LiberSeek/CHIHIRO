# Copy to deploy/.env before starting:
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#
# Values in this file are safe development defaults. Pin image tags or
# digests, and replace all credentials, before a shared deployment.

TZ=Asia/Shanghai

# Host-side product binding. The container listens on 3100 internally.
CHIHIRO_BIND_HOST=127.0.0.1
CHIHIRO_PORT=3100
CHIHIRO_IMAGE=chihiro:dev

# The current Gateway reads these values from its generated local config.
# Compose service names are valid only inside the default network.
# Leave service URLs empty to use the standard Compose defaults. The external
# NapCat override supplies host.docker.internal defaults for its three URLs.
CHIHIRO_ASTRBOT_URL=
CHIHIRO_NAPCAT_WEBUI_URL=
CHIHIRO_ONEBOT_HTTP_URL=
CHIHIRO_ONEBOT_WS_URL=

# AstrBot is an internal service. Pin this to a tested release or digest.
ASTRBOT_IMAGE=soulter/astrbot:latest

# The Linux NapCat image is intentionally not enabled by default. Set this
# after validating a concrete image and start the `linux-napcat` profile.
NAPCAT_IMAGE=replace-with-validated-napcat-image
